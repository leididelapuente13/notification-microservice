# ==========================================
# Notification Service Environment Variables
# ==========================================

# Port (configured automatically by Render, defaults to 8080 locally)
PORT=8080

# RabbitMQ / CloudAMQP connection URL
# Local example: amqp://guest:guest@localhost:5672
# CloudAMQP / Render example: amqps://user:password@hostname/vhost
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Brevo (Sendinblue) API Credentials
# NOTE: BREVO_API_KEY must start with "xkeysib-"
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_FROM_ADDRESS=notifications@yourdomain.com
BREVO_FROM_NAME=Notification Service
BREVO_BASE_URL=https://api.brevo.com

# Optional Queue Configuration (defaults already set in application.properties)
# RABBITMQ_NOTIFICATION_QUEUE=notification.events.queue
# RABBITMQ_DOMAIN_EXCHANGE=domain.events
# RABBITMQ_NOTIFICATION_ROUTING_KEY=user.#

